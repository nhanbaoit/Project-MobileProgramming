<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.ChiTietBenhAnActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#5EC2B7"
        android:gravity="center"
        android:padding="30dp"
        android:paddingBottom="16dp"
        android:text="Chi tiết bệnh án"
        android:textColor="#FFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginVertical="20dp"
        android:padding="4dp"
        android:src="@drawable/so_benh_an" />

    <TextView
        android:id="@+id/tvNgayKham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:hint="Ngày khám (dd/MM/yyyy): "
        android:inputType="text"
        android:padding="5dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvTrieuChung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="20dp"
        android:hint="Triệu chứng"
        android:padding="5dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvChanDoan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="5dp"
        android:hint="Chuẩn đoán"
        android:padding="5dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvThuoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="20dp"
        android:hint="Thuốc điều trị"
        android:padding="5dp"
        android:textSize="20sp" />
</LinearLayout>